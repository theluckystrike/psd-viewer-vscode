{
  "name": "zovo-psd-viewer",
  "displayName": "PSD Viewer & Layer Preview",
  "description": "PSD viewer with the merged image, document details and a searchable layer list. Open PSD and PSB files offline in VS Code.",
  "version": "0.1.1",
  "publisher": "zovo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/psd-viewer-vscode"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "psd",
    "psd viewer",
    "photoshop",
    "layers",
    "design"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "psdViewer.preview",
        "displayName": "PSD Viewer & Layer Preview",
        "selector": [
          {
            "filenamePattern": "*.psd"
          },
          {
            "filenamePattern": "*.psb"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "psdViewer.openWith",
        "title": "Open in PSD Viewer & Layer Preview",
        "category": "PSD Viewer & Layer Preview"
      },
      {
        "command": "psdViewer.getPro",
        "title": "Get Zovo Pro (USD 19 once, all 22 Zovo extensions)",
        "category": "Zovo Pro"
      },
      {
        "command": "psdViewer.payWithPayPal",
        "title": "Pay for Zovo Pro with PayPal (USD 19, team of 5 USD 59)",
        "category": "Zovo Pro"
      },
      {
        "command": "psdViewer.unlockWithSponsors",
        "title": "I already paid: unlock with GitHub Sponsors",
        "category": "Zovo Pro"
      },
      {
        "command": "psdViewer.enterLicenseKey",
        "title": "Enter Zovo Pro license key",
        "category": "Zovo Pro"
      },
      {
        "command": "psdViewer.removeLicense",
        "title": "Remove Zovo Pro from this editor",
        "category": "Zovo Pro"
      },
      {
        "command": "psdViewer.payByCard",
        "title": "Pay for Zovo Pro by card (USD 19)",
        "category": "Zovo Pro"
      },
      {
        "command": "psdViewer.enterKey",
        "title": "Enter a key",
        "category": "Zovo Pro"
      },
      {
        "command": "psdViewer.layers",
        "title": "Export layers as PNG files",
        "category": "PSD Viewer & Layer Preview Pro"
      },
      {
        "command": "psdViewer.text",
        "title": "List text layers and CSS",
        "category": "PSD Viewer & Layer Preview Pro"
      },
      {
        "command": "psdViewer.compare",
        "title": "Compare two PSD files",
        "category": "PSD Viewer & Layer Preview Pro"
      },
      {
        "command": "psdViewer.zovoPro.layers",
        "title": "Zovo Pro: Export layers as PNG files"
      },
      {
        "command": "psdViewer.zovoPro.text",
        "title": "Zovo Pro: List text layers and CSS"
      },
      {
        "command": "psdViewer.zovoPro.compare",
        "title": "Zovo Pro: Compare two PSD files"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "psdViewer.openWith",
          "when": "resourceExtname =~ /\\.(psd|psb)$/i",
          "group": "navigation@9"
        },
        {
          "command": "psdViewer.zovoPro.layers",
          "when": "resourceExtname == .psd",
          "group": "zovoPro@1"
        },
        {
          "command": "psdViewer.zovoPro.layers",
          "when": "resourceExtname == .psb",
          "group": "zovoPro@1"
        },
        {
          "command": "psdViewer.zovoPro.text",
          "when": "resourceExtname == .psd",
          "group": "zovoPro@1"
        },
        {
          "command": "psdViewer.zovoPro.text",
          "when": "resourceExtname == .psb",
          "group": "zovoPro@1"
        },
        {
          "command": "psdViewer.zovoPro.compare",
          "when": "resourceExtname == .psd",
          "group": "zovoPro@1"
        },
        {
          "command": "psdViewer.zovoPro.compare",
          "when": "resourceExtname == .psb",
          "group": "zovoPro@1"
        }
      ],
      "commandPalette": [
        {
          "command": "psdViewer.zovoPro.layers",
          "when": "false"
        },
        {
          "command": "psdViewer.zovoPro.text",
          "when": "false"
        },
        {
          "command": "psdViewer.zovoPro.compare",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "PSD Viewer & Layer Preview",
      "properties": {
        "psdViewer.maxFileMB": {
          "type": "number",
          "default": 512,
          "minimum": 1,
          "maximum": 2048,
          "description": "Largest local file size to open in megabytes."
        },
        "psdViewer.askForRating": {
          "type": "boolean",
          "default": true,
          "description": "Ask whether this extension is useful after successful file opens."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies -o dist/"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/theluckystrike/sponsorships?tier_id=679878"
  }
}
